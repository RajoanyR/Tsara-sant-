# Copiez ce fichier en ".env" puis renseignez vos identifiants EmailJS (clé PUBLIQUE uniquement).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optionnel : second modèle dédié au formulaire de contact (sinon le modèle ci-dessus est utilisé)
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
